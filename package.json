{
  "name": "paintbox",
  "displayName": "miniPaint — Image Editor for VS Code",
  "description": "miniPaint by ViliusL, packaged as a VS Code custom editor with proper save-to-disk for code-server. The editor is upstream MIT work; this extension provides the VS Code integration.",
  "version": "0.1.0",
  "publisher": "NateDogDotNet",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/NateDogDotNet/paintbox#readme",
  "bugs": {
    "url": "https://github.com/NateDogDotNet/paintbox/issues"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "image editor",
    "paint",
    "photo editor",
    "minipaint",
    "code-server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NateDogDotNet/paintbox"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "paintbox.imageEditor",
        "displayName": "Paintbox Image Editor",
        "selector": [
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.webp" }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/patch-bundle.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-yarn",
    "publish:ovsx": "ovsx publish paintbox-*.vsix --pat $OVSX_PAT"
  },
  "devDependencies": {
    "@types/vscode": "^1.87.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.26.0",
    "eslint": "^8.57.1",
    "mocha": "^10.4.0",
    "ovsx": "^0.9.0",
    "playwright": "^1.59.1",
    "sharp": "^0.33.5",
    "typescript": "^5.4.0"
  }
}
